<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <AssemblyName>Pdf2GdbStudio</AssemblyName>
    <RootNamespace>GanjoorPdfToGdb.WinForms</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Pdf2Gdb Studio</Product>
    <Company>Ganjoor</Company>
    <Description>Convert scanned Persian poetry books to Desktop Ganjoor GDB files</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GanjoorPdfToGdb.Core\GanjoorPdfToGdb.Core.csproj" />
  </ItemGroup>

  <!-- the saved Naskban password is encrypted with Windows DPAPI -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <!-- Optional: put the unzipped poppler folder in src\GanjoorPdfToGdb.WinForms\poppler and it is copied
       next to the exe on every build (the app finds pdftoppm.exe anywhere below that folder). -->
  <ItemGroup>
    <None Update="poppler\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
