{
  // Put the key in the environment variable GDB_API_KEY instead of here whenever you can.
  "BaseUrl": "https://api.avalai.ir/v1",
  "ApiKey": "",
  "Model": "claude-sonnet-5-5",

  "Temperature": 0,
  "MaxOutputTokens": 8000,
  "MaxTokensParameter": "max_tokens",
  "UseJsonResponseFormat": true,
  "MaxRetries": 3,
  "RenderDpi": 200,

  "PoemTitleTemplate": "شمارهٔ {number}",
  "UntitledPoemTemplate": "بدون عنوان {n}",
  "DisambiguateDuplicateTitles": true,
  "NormalizeHeYeToHamza": true,
  "UnknownCategoryTitle": "نامشخص",
  "IncludeProse": false,
  "AutoCorrectPoemNumbers": true,
  "SubSectionPrefixes": ["حرف"],

  "FirstPoetId": 1001,
  "FirstCatId": 10001,
  "FirstPoemId": 100001
}
